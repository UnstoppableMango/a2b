{
  "name": "pairs",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": { "type": "SYMBOL", "name": "pair" }
    },
    "pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": { "type": "SYMBOL", "name": "word" }
        },
        { "type": "STRING", "value": "=" },
        {
          "type": "FIELD",
          "name": "value",
          "content": { "type": "SYMBOL", "name": "word" }
        }
      ]
    },
    "word": { "type": "PATTERN", "value": "[a-z]+" }
  },
  "extras": [{ "type": "PATTERN", "value": "\\s" }]
}
